# Search provider: auto | tavily | ddgs   (auto = tavily if key present, else ddgs)
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# Identify ourselves honestly to sites and robots.txt
USER_AGENT=Mozilla/5.0 (compatible; CARDIO4CitiesResearchBot/0.1; +https://www.cardio4cities.org/)

# Politeness / limits
MIN_SECONDS_BETWEEN_REQUESTS_PER_DOMAIN=1.0
REQUEST_TIMEOUT_SECONDS=20
MAX_DOCUMENT_BYTES=8000000
MAX_TEXT_CHARS=60000
MAX_PDF_PAGES=40
# What to do when robots.txt cannot be reached (5xx / timeout): deny | allow
ROBOTS_UNREACHABLE_POLICY=deny

# LLM
GROQ_API_KEY=
GROQ_MODEL_PLANNER=openai/gpt-oss-120b
GROQ_MODEL_EXTRACTOR=openai/gpt-oss-20b
GROQ_MODEL_CHECKER=openai/gpt-oss-120b
GROQ_MODEL_ANSWER=openai/gpt-oss-120b
# tokens-per-minute budget we allow ourselves per model (free tier limit is 8000)
GROQ_TPM_BUDGET=7000
