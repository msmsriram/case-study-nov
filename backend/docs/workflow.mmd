---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	search(search)
	crawl_check(crawl_check)
	fetch(fetch)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	crawl_check --> fetch;
	plan --> search;
	search -.-> __end__;
	search -.-> crawl_check;
	fetch --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
