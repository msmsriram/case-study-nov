	__start__ --> plan;
	collect_claims -.-> fact_check;
	collect_claims -.-> gap_analysis;
	crawl_check --> fetch;
	detect_conflicts --> gap_analysis;
	extract_claims --> collect_claims;
	fact_check --> detect_conflicts;
	fetch -.-> extract_claims;
	fetch -.-> gap_analysis;
	gap_analysis --> persist;
	persist --> build_graph;
	plan --> search;
	search -.-> __end__;
	search -.-> crawl_check;
	build_graph --> __end__;
